# Healthcare Backend Environment Variables
# Copy this file to .env and fill in values

DEBUG=True
SECRET_KEY=change-me-to-a-random-50-char-string-in-production

# Docker PostgreSQL (port 5433 — see docker command below)
# docker run -d --name healthcare_pg -e POSTGRES_USER=healthcare_user -e POSTGRES_PASSWORD=healthcare_pass -e POSTGRES_DB=healthcare_db -p 5433:5432 --restart unless-stopped postgres:16-alpine
DB_NAME=healthcare_db
DB_USER=healthcare_user
DB_PASSWORD=healthcare_pass
DB_HOST=localhost
DB_PORT=5433

ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:3000
